# name: test/sql/secrets/s3_url_scheme_aliases.test
# description: Test the s3_url_scheme_aliases setting (using oss:// as an example scheme)
# group: [secrets]

require httpfs

# FIXME: s3_url_scheme_aliases is not yet in duckdb's autoload registry
statement ok
LOAD httpfs;

statement ok
set secret_directory='{TEST_DIR}/s3_url_scheme_aliases'

# Without the setting, oss:// urls are not recognized by any filesystem
statement error
FROM 'oss://test-bucket/test.csv'
----
<REGEX>:.*(No such file or directory|No files found).*

# Register oss:// as an S3-compatible scheme alias
statement ok
SET s3_url_scheme_aliases = ['oss'];

# Aliased stores are not AWS, so they need an endpoint (see the guard test below)
statement ok
SET s3_endpoint = 'storage.example.com';

query I
SELECT current_setting('s3_url_scheme_aliases');
----
[oss]

# oss:// urls are now routed to the S3 filesystem: the S3 url parser rejects a
# bucket-less url locally, proving the path no longer fails with 'file not found'
statement error
FROM 'oss:///test.csv'
----
<REGEX>:.*URL needs to contain a bucket name.*

# Aliases are lowercased and deduplicated
statement ok
SET s3_url_scheme_aliases = ['OSS', 'oss', 'cos'];

query I
SELECT current_setting('s3_url_scheme_aliases');
----
[oss, cos]

# Only bare scheme names are accepted
statement error
SET s3_url_scheme_aliases = ['oss://'];
----
<REGEX>:.*provide bare scheme names.*

statement error
SET s3_url_scheme_aliases = ['oss bucket'];
----
<REGEX>:.*provide bare scheme names.*

# NULL elements are rejected
statement error
SET s3_url_scheme_aliases = ['oss', NULL];
----
<REGEX>:.*does not accept NULL elements.*

# Schemes of built-in filesystems cannot be aliased
statement error
SET s3_url_scheme_aliases = ['s3'];
----
<REGEX>:.*already handled by a built-in filesystem.*

statement error
SET s3_url_scheme_aliases = ['https'];
----
<REGEX>:.*already handled by a built-in filesystem.*

statement error
SET s3_url_scheme_aliases = ['file'];
----
<REGEX>:.*already handled by a built-in filesystem.*

# ... including schemes core maps to another extension
statement error
SET s3_url_scheme_aliases = ['az'];
----
<REGEX>:.*already handled by a built-in filesystem.*

statement error
SET s3_url_scheme_aliases = ['abfss'];
----
<REGEX>:.*already handled by a built-in filesystem.*

statement error
SET s3_url_scheme_aliases = ['abfs'];
----
<REGEX>:.*already handled by a built-in filesystem.*

# The setting is global-only
statement error
SET SESSION s3_url_scheme_aliases = ['oss'];
----
<REGEX>:.*can only be set globally.*

statement error
RESET SESSION s3_url_scheme_aliases;
----
<REGEX>:.*can only be set globally.*

# The default scope of new S3 secrets does not include aliases:
# secrets for aliased schemes need an explicit SCOPE
statement ok
SET s3_url_scheme_aliases = ['oss', 'cos'];

statement ok
CREATE SECRET default_scope_secret (TYPE S3, KEY_ID 'my_key', SECRET 'my_secret');

query I
SELECT scope FROM duckdb_secrets() WHERE name = 'default_scope_secret';
----
['s3://', 's3n://', 's3a://']

# Two aliases with two differently scoped secrets resolve independently
statement ok
CREATE SECRET oss_secret (TYPE S3, KEY_ID 'oss_key', SECRET 'oss_secret_key', SCOPE 'oss://');

statement ok
CREATE SECRET cos_secret (TYPE S3, KEY_ID 'cos_key', SECRET 'cos_secret_key', SCOPE 'cos://');

query I
SELECT name FROM which_secret('oss://test-bucket/test.csv', 's3');
----
oss_secret

query I
SELECT name FROM which_secret('cos://test-bucket/test.csv', 's3');
----
cos_secret

# An alias means the store is not AWS, so a missing endpoint is an error rather than a
# silent fallback to s3.amazonaws.com
statement ok
RESET s3_endpoint;

statement ok
CREATE SECRET no_endpoint_secret (TYPE S3, KEY_ID 'k', SECRET 's', SCOPE 'oss://');

statement error
FROM 'oss://test-bucket/test.csv'
----
<REGEX>:.*aliased URL scheme requires an endpoint.*

statement ok
SET s3_endpoint = 'storage.example.com';

# ... and a url query parameter cannot clear it either
statement error
FROM 'oss://test-bucket/test.csv?s3_endpoint='
----
<REGEX>:.*aliased URL scheme requires an endpoint.*

statement error
FROM 'oss://test-bucket/test.csv?s3_endpoint=%20'
----
<REGEX>:.*aliased URL scheme requires an endpoint.*

statement ok
DROP SECRET no_endpoint_secret;

# RESET restores the default (no aliases)
statement ok
RESET s3_url_scheme_aliases;

query I
SELECT current_setting('s3_url_scheme_aliases');
----
[]

statement error
FROM 'oss://test-bucket/test.csv'
----
<REGEX>:.*(No such file or directory|No files found).*

# An empty list also disables routing
statement ok
SET s3_url_scheme_aliases = ['oss'];

statement ok
SET s3_url_scheme_aliases = [];

statement error
FROM 'oss://test-bucket/test.csv'
----
<REGEX>:.*(No such file or directory|No files found).*
