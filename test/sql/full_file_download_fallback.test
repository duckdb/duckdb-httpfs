# name: test/sql/full_file_download_fallback.test
# group: [sql]

require parquet

require httpfs

require tpch

require-env PYTHON_HTTP_SERVER_URL

require-env PYTHON_HTTP_SERVER_DIR

# FIXME: SKIP — this test triggers a confirmed deadlock in duckdb CORE, a regression
# from bumping the duckdb submodule to main. MultiFileFunction::ClaimNextJob holds
# gstate.lock across TryInitializeScan, under which the external file cache runs a
# NESTED executor.WorkOnTasks() whose FetchBlockTask -> httpfs FullDownload acquires
# CachedFile::lock. On a small worker pool (CI runners; reproduced locally at
# threads=2) the pool starves and every thread futex-parks. The fix must land upstream
# in duckdb/duckdb — httpfs cannot break the core lock cycle. Skipping so CI is not
# wedged and any downstream failures can surface. See bump_to_main worker memory
# (2026-07-06 "ROOT CAUSE FOUND + REPRODUCED").
mode skip

statement ok
CALL enable_logging();

statement ok
call dbgen(sf=1);

statement ok
copy lineitem to '{PYTHON_HTTP_SERVER_DIR}/lineitem.csv'

statement ok
drop table lineitem;

statement ok
CREATE view lineitem AS FROM '{PYTHON_HTTP_SERVER_URL}/lineitem.csv';

query I
pragma tpch(6);
----
123141078.22829981

query I
select count(*) from duckdb_logs where log_level='WARNING' and message like '%Falling back to full%'
----
2

statement ok
set auto_fallback_to_full_download=false

statement error
pragma tpch(6);
----
HTTP Error: Content-Length from server mismatches requested range, server may not support range requests. You can try to resolve this by enabling `SET force_download=true`

