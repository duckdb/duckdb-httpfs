# name: test/sql/secret/secret_s3_sign_http_urls.test
# description: An S3 secret with SIGN_HTTP_URLS signs plain http(s) urls inside its scope as S3 requests
# group: [secret]

require-env S3_TEST_SERVER_AVAILABLE 1

require-env AWS_DEFAULT_REGION

require-env AWS_ACCESS_KEY_ID

require-env AWS_SECRET_ACCESS_KEY

require-env DUCKDB_S3_ENDPOINT

require-env DUCKDB_S3_USE_SSL

require httpfs

require parquet

# override the default behaviour of skipping HTTP errors and connection failures: this test fails on connection issues
set ignore_error_messages

statement ok
SET enable_global_s3_configuration=false

# the object, written the usual way
statement ok
CREATE SECRET s3_scope (TYPE S3, KEY_ID '{AWS_ACCESS_KEY_ID}', SECRET '{AWS_SECRET_ACCESS_KEY}', REGION '{AWS_DEFAULT_REGION}', ENDPOINT '{DUCKDB_S3_ENDPOINT}', USE_SSL {DUCKDB_S3_USE_SSL}, URL_STYLE 'path')

statement ok
COPY (SELECT 42 AS i) TO 's3://test-bucket/sign_http_urls/object.parquet'

statement ok
DROP SECRET s3_scope

# a secret scoped to the endpoint's http url, without the opt-in: the url stays a plain http url, which the bucket
# refuses unsigned
statement ok
CREATE SECRET http_scope (TYPE S3, SCOPE 'http://{DUCKDB_S3_ENDPOINT}/', KEY_ID '{AWS_ACCESS_KEY_ID}', SECRET '{AWS_SECRET_ACCESS_KEY}', REGION '{AWS_DEFAULT_REGION}', ENDPOINT '{DUCKDB_S3_ENDPOINT}', USE_SSL {DUCKDB_S3_USE_SSL}, URL_STYLE 'path')

statement error
SELECT i FROM 'http://{DUCKDB_S3_ENDPOINT}/test-bucket/sign_http_urls/object.parquet'
----
<REGEX>:.*(403|Forbidden|Access Denied).*

statement ok
DROP SECRET http_scope

# with the opt-in the same url is an S3 request, signed with the secret
statement ok
CREATE SECRET http_signed (TYPE S3, SCOPE 'http://{DUCKDB_S3_ENDPOINT}/', KEY_ID '{AWS_ACCESS_KEY_ID}', SECRET '{AWS_SECRET_ACCESS_KEY}', REGION '{AWS_DEFAULT_REGION}', ENDPOINT '{DUCKDB_S3_ENDPOINT}', USE_SSL {DUCKDB_S3_USE_SSL}, URL_STYLE 'path', SIGN_HTTP_URLS true)

query I
SELECT i FROM 'http://{DUCKDB_S3_ENDPOINT}/test-bucket/sign_http_urls/object.parquet'
----
42

query I
SELECT count(*) FROM glob('http://{DUCKDB_S3_ENDPOINT}/test-bucket/sign_http_urls/*.parquet')
----
1

# the option is a boolean
statement error
CREATE SECRET bad (TYPE S3, SIGN_HTTP_URLS 'yes')
----
<REGEX>:.*expected: 'BOOLEAN'.*
