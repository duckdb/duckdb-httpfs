# name: test/sql/secret/secret_refresh_persistent.test
# description: Tests refreshing persistent S3 secrets
# group: [secret]

require-env S3_TEST_SERVER_AVAILABLE 1

require-env AWS_DEFAULT_REGION

require-env AWS_ACCESS_KEY_ID

require-env AWS_SECRET_ACCESS_KEY

require-env DUCKDB_S3_ENDPOINT

require-env DUCKDB_S3_USE_SSL

set ignore_error_messages

require httpfs

require parquet

statement ok
SET secret_directory='{TEST_DIR}/secret_refresh_persistent'

statement ok
set s3_use_ssl='{DUCKDB_S3_USE_SSL}'

statement ok
set s3_endpoint='{DUCKDB_S3_ENDPOINT}'

statement ok
set s3_region='{AWS_DEFAULT_REGION}'

# Create test data with valid temporary credentials.
statement ok
CREATE SECRET writer (
    TYPE S3,
    KEY_ID '{AWS_ACCESS_KEY_ID}',
    SECRET '{AWS_SECRET_ACCESS_KEY}'
)

statement ok
copy (select 42 as a) to 's3://test-bucket/persistent-secret-refresh.parquet'

statement ok
DROP SECRET writer

statement ok
CREATE OR REPLACE PERSISTENT SECRET s1 (
    TYPE S3,
    KEY_ID 'BOGUS',
    SECRET 'ALSO BOGUS',
    REFRESH_INFO MAP {
        'KEY_ID': '{AWS_ACCESS_KEY_ID}',
        'SECRET': '{AWS_SECRET_ACCESS_KEY}'
    }
)

query I
FROM "s3://test-bucket/persistent-secret-refresh.parquet"
----
42

query IIII
SELECT name, persistent, storage, secret_string LIKE '%key_id={AWS_ACCESS_KEY_ID}%'
FROM duckdb_secrets(redact=false)
WHERE name='s1'
----
s1	true	local_file	true

query I
SELECT count(*) FROM duckdb_secrets(redact=false) WHERE name='s1'
----
1

restart

statement ok
SET secret_directory='{TEST_DIR}/secret_refresh_persistent'

query IIII
SELECT name, persistent, storage, secret_string LIKE '%key_id={AWS_ACCESS_KEY_ID}%'
FROM duckdb_secrets(redact=false)
WHERE name='s1'
----
s1	true	local_file	true
