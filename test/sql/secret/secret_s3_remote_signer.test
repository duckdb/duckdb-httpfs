# name: test/sql/secret/secret_s3_remote_signer.test
# description: Validation and redaction of the remote signer options of S3 secrets
# group: [secret]

require httpfs

statement ok
CREATE SECRET signed (
    TYPE S3,
    SIGNER_URL 'https://catalog.example.com/v1/warehouse/namespaces/sales/tables/orders/sign',
    SIGNER_HEADERS MAP {'Authorization': 'Bearer top-secret-token'},
    SIGNER_PROPERTIES MAP {'warehouse': 'demo'},
    REGION 'eu-west-1'
)

# The headers authenticate the client to the signer, so they are never shown
query I
SELECT secret_string LIKE '%signer_headers=redacted%' AND secret_string NOT LIKE '%top-secret-token%'
FROM duckdb_secrets() WHERE name = 'signed'
----
true

query I
SELECT secret_string LIKE '%signer_url=https://catalog.example.com/v1/warehouse/namespaces/sales/tables/orders/sign%'
FROM duckdb_secrets() WHERE name = 'signed'
----
true

# REFRESH 'auto' keeps a copy of every option in refresh_info, which must not leak the headers either
statement ok
CREATE SECRET signed_auto_refresh (
    TYPE S3,
    SIGNER_URL 'https://catalog.example.com/sign',
    SIGNER_HEADERS MAP {'Authorization': 'Bearer top-secret-token'},
    REFRESH 'auto'
)

query I
SELECT secret_string NOT LIKE '%top-secret-token%' FROM duckdb_secrets() WHERE name = 'signed_auto_refresh'
----
true

statement error
CREATE SECRET (
    TYPE S3,
    SIGNER_URL 'https://catalog.example.com/sign',
    KEY_ID 'my-key',
    SECRET 'my-secret'
)
----
SIGNER_URL cannot be combined with

statement error
CREATE SECRET (
    TYPE S3,
    SIGNER_URL 'https://catalog.example.com/sign',
    SESSION_TOKEN 'my-token'
)
----
SIGNER_URL cannot be combined with SESSION_TOKEN

statement error
CREATE SECRET (TYPE S3, SIGNER_URL 'catalog.example.com/sign')
----
SIGNER_URL must be an http:// or https:// URL

statement error
CREATE SECRET (TYPE S3, SIGNER_HEADERS MAP {'Authorization': 'Bearer top-secret-token'})
----
SIGNER_HEADERS requires SIGNER_URL

statement error
CREATE SECRET (TYPE S3, SIGNER_PROPERTIES MAP {'warehouse': 'demo'})
----
SIGNER_PROPERTIES requires SIGNER_URL

# Remote signing is part of the S3 protocol used by s3:// secrets only
statement error
CREATE SECRET (TYPE GCS, SIGNER_URL 'https://catalog.example.com/sign')
----
Unknown parameter "signer_url" for secret type "gcs"
