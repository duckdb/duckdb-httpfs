# name: test/sql/secret/gcs_generation.test
# description: Validate explicit GCS generation selectors before dispatch
# group: [secret]

require httpfs

statement ok
CREATE SECRET generation_test (TYPE GCS, ENDPOINT '127.0.0.1:1', URL_STYLE 'path', USE_SSL false);

statement ok
SET http_retries=0;

foreach generation 0 -1 1.0 1e3 18446744073709551616

statement error
SELECT * FROM read_blob('gs://bucket/key?gcs_generation={generation}');
----
gcs_generation must be a positive uint64 decimal

endloop

statement error
SELECT * FROM read_blob('gcs://bucket/key?gcs_generation=');
----
gcs_generation must be a positive uint64 decimal

statement error
SELECT * FROM read_blob('gcs://bucket/key?gcs_generation=1&gcs_generation=2');
----
Duplicate S3 URL query parameter 'gcs_generation'

statement error
SELECT * FROM read_blob('gcs://bucket/key?gcs_generation=1&s3_version_id=opaque');
----
gcs_generation and s3_version_id cannot be combined

statement error
SELECT * FROM read_blob('s3://bucket/key?gcs_generation=1');
----
gcs_generation is only supported for GCS URLs

statement error
COPY (SELECT 42) TO 'gs://bucket/key?gcs_generation=123' (FORMAT CSV);
----
gcs_generation is only supported for reading

statement error
SELECT * FROM glob('gcs://bucket/*.csv?gcs_generation=123');
----
The gcs_generation parameter cannot be used with glob patterns
