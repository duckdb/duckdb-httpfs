# name: test/sql/attach/attach_httpfs.test
# description: Test attach using httpfs
# group: [attach]

require httpfs

require-env S3_TEST_SERVER_AVAILABLE 1

require-env AWS_DEFAULT_REGION

require-env AWS_ACCESS_KEY_ID

require-env AWS_SECRET_ACCESS_KEY

require-env DUCKDB_S3_ENDPOINT

require-env DUCKDB_S3_USE_SSL

require-env S3_ATTACH_DB_PRESIGNED_URL

# ATTACH a DuckDB database over HTTPFS: the WAL path is derived by appending ".wal" to the presigned URL's path,
# so it reuses the database file's signature and the server rejects it
statement error
ATTACH '{S3_ATTACH_DB_PRESIGNED_URL}' AS db (READONLY 1);
----
HTTP 403
